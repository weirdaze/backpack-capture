{
  "manifest_version": 3,
  "name": "Backpack Capture",
  "version": "0.2.3",
  "description": "Reads the Google Classroom or Genesis Parent Portal page you're already logged into and reduces it to a JSON export. Read-only, local-only, no login automation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "downloads", "scripting", "activeTab"],
  "host_permissions": ["https://classroom.google.com/*", "*://*/genesis/parents*"],
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*"],
      "js": ["src/core-reduce.js", "src/core-content.js", "src/reducer.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/genesis/parents*"],
      "js": ["src/core-reduce.js", "src/core-content.js", "src/genesis-reducer.js", "src/genesis-content.js"],
      "run_at": "document_idle"
    }
  ]
}
